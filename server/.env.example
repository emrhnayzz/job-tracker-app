# Copy this file to .env and fill in the values.

# PostgreSQL connection. The docker-compose.yml in the project root starts a
# matching database on port 5433.
DATABASE_URL=postgres://myuser:mypassword@localhost:5433/jobtracker

# Secret used to sign login tokens. Use a long random string in production,
# for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change-me

# Port of the API (optional, default 5001).
PORT=5001

# Comma-separated list of origins that may call the API (optional).
# Leave empty during development to allow every origin.
CLIENT_ORIGIN=

# Google Gemini key for the cover letter draft (optional). Without it the app
# returns a fill-in template instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Emails state times as people say them ("10 Uhr"). They are read in this zone.
APP_TIMEZONE=Europe/Berlin

# Domain of the personal forwarding addresses (optional). When set, every
# user gets an address <token>@<domain>. Point the mail provider's inbound
# webhook for that domain at POST /inbound/<token>.
INBOUND_DOMAIN=

# Only for "npm test": a separate, empty database. Its tables are wiped.
TEST_DATABASE_URL=
